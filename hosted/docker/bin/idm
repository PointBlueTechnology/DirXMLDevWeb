#!/bin/sh
# The idm CLI inside the container: DirXMLDev's jar, the simulator, and the engine jars the
# customer mounted at $IDM_LIB. `docker exec idmweb idm …` is the same command an agent runs
# on a workstation.
set -e
IDM_HOME=${IDM_HOME:-/opt/idmweb}
IDM_LIB=${IDM_LIB:-/opt/idm/lib}
CP="$IDM_HOME/lib/dirxml-dev.jar:$IDM_HOME/lib/dirxml-simulator.jar"
for j in "$IDM_LIB"/*.jar; do [ -f "$j" ] && CP="$CP:$j"; done
exec java ${IDM_JAVA_OPTS:-} -Didm.home="$IDM_HOME" -cp "$CP" com.pointblue.dirxml.dev.Cli "$@"
