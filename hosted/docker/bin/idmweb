#!/bin/sh
# The web server inside the container, on the same class path as idm.
set -e
IDM_HOME=${IDM_HOME:-/opt/idmweb}
IDM_LIB=${IDM_LIB:-/opt/idm/lib}
CP="$IDM_HOME/lib/dirxml-dev-web.jar:$IDM_HOME/lib/dirxml-dev.jar:$IDM_HOME/lib/dirxml-simulator.jar"
for j in "$IDM_LIB"/*.jar; do [ -f "$j" ] && CP="$CP:$j"; done
exec java ${IDM_JAVA_OPTS:-} -Didmweb.home="$IDM_HOME" -Didm.home="$IDM_HOME" -cp "$CP" com.pointblue.dirxml.web.Serve "$@"
