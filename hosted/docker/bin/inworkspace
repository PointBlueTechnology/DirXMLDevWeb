# Sourced by idm, sim and apps: the local install (docs/simple-install.md) runs them in your workspace
# of the first project's branch main (IDMWEB_PROJECT and IDMWEB_BRANCH pick another), with your own
# credentials file, when they start in the image's working directory. Anywhere else (a `-w` into a
# tree, a team server) they run where they are.
H=/etc/idmweb/hosted.properties
if [ -f "$H" ] && [ "$(pwd)" = /opt/idmweb ]; then
  san() { printf '%s' "$1" | sed 's#[^A-Za-z0-9._-]#_#g'; }
  U=$(sed -n 's/^token\.user=//p' "$H" | head -1)
  if [ -n "$U" ]; then
    S=$(san "$U")
    MINE="/var/lib/idmweb/users/$S/environments.properties"
    if [ -z "${IDM_CREDENTIALS:-}" ] && [ -f "$MINE" ]; then export IDM_CREDENTIALS="$MINE"; fi
    P=${IDMWEB_PROJECT:-$(sed -n 's/^projects=//p' "$H" | head -1 | cut -d, -f1)}
    B=${IDMWEB_BRANCH:-main}
    if [ -n "$P" ]; then
      W="/var/lib/idmweb/workspaces/$(san "$P")/$S/$(san "$B")"
      if [ -d "$W" ]; then cd "$W"; else echo "note: no workspace for $P/$B yet (open the branch on the page); running outside one" >&2; cd /var/lib/idmweb; fi
    else
      cd /var/lib/idmweb
    fi
  fi
fi
