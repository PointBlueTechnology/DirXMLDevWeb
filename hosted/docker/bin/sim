#!/bin/sh
# The DirXML Policy Simulator's CLI inside the container (bin/sim on a workstation): the simulator's jar
# and the engine jars the customer mounted at $IDM_LIB. `docker exec idmweb sim …`.
set -e
. /opt/idmweb/bin/inworkspace
IDM_HOME=${IDM_HOME:-/opt/idmweb}
IDM_LIB=${IDM_LIB:-/opt/idm/lib}
CP="$IDM_HOME/lib/dirxml-simulator.jar"
for j in "$IDM_LIB"/*.jar; do [ -f "$j" ] && CP="$CP:$j"; done
exec java ${SIM_JAVA_OPTS:-} -cp "$CP" com.pointblue.dirxml.sim.Cli "$@"
