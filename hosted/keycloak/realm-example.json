{
  "realm": "idm",
  "enabled": true,
  "groups": [
    {
      "name": "idm-editors"
    },
    {
      "name": "idm-deployers"
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "firstName": "Alice",
      "lastName": "Example",
      "email": "alice@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice-test-pw",
          "temporary": false
        }
      ],
      "groups": [
        "/idm-editors"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "firstName": "Bob",
      "lastName": "Deployer",
      "email": "bob@example.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob-test-pw",
          "temporary": false
        }
      ],
      "groups": [
        "/idm-deployers"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "idmweb",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "idmweb-test-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8081/*"
      ],
      "webOrigins": [
        "http://localhost:8081"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
