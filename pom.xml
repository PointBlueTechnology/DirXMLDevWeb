<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pointblue.dirxml</groupId>
    <artifactId>dirxml-dev-web</artifactId>
    <version>0.40.0</version>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>
    <packaging>jar</packaging>
    <name>DirXMLDevWeb</name>
    <description>A browser workbench over the DirXMLDev core, served from the workstation.</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- The DirXMLDev release this server is written against. Install it once with
             `mvn -o install -DskipTests` in the DirXMLDev checkout; bin/idmweb then runs
             against that checkout's classes, engine jars and simulator. -->
        <dirxmldev.version>0.28.0</dirxmldev.version>
        <simulator.version>1.7.0</simulator.version>
        <!-- the DirXML Trace Viewer's library: parser, highlighter, LDAP trace source (its release attaches the jar) -->
        <!-- Directory Console's shared libraries (console-auth: OIDC sign-in, TLS trust). Install with
             `mvn install` in the directory-console checkout. -->
        <console.version>0.1.0</console.version>
        <tracecore.version>1.5.0</tracecore.version>
        <!-- the PostgreSQL JDBC driver the core's event store opens; the core's release attaches it too -->
        <postgresql.version>42.7.7</postgresql.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.pointblue.console</groupId>
            <artifactId>console-auth</artifactId>
            <version>${console.version}</version>
            <exclusions>
                <!-- its dirxml-dev dependency is the same core this server already declares -->
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.pointblue.dirxml</groupId>
            <artifactId>dirxml-dev</artifactId>
            <version>${dirxmldev.version}</version>
            <scope>provided</scope>
            <!-- DirXMLDev's own dependencies are the proprietary engine jars (system-scoped in
                 its pom) and the simulator; the launcher supplies them at run time. -->
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- The simulator's own result types (stages, comparison) for the simulator view. Installed by
             'mvn install' in the DirXMLSimulator repo; the launcher supplies it at run time. -->
        <dependency>
            <groupId>com.pointblue.dirxml</groupId>
            <artifactId>dirxml-simulator</artifactId>
            <version>${simulator.version}</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Live trace: the viewer's parser and highlighting, so the page shows what the desktop shows.
             jldap comes with it for compiling; at run time the engine's own ldap.jar (same classes)
             is on the class path, so the launchers add only this jar. -->
        <dependency>
            <groupId>com.pointbluetech</groupId>
            <artifactId>dirxml-trace-core</artifactId>
            <version>${tracecore.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
